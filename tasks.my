   ("WSM-OS-CML-TAIL-CALL-PROOF-M5C" .
    ((priority . 8.5)
     (capabilities . (cml compiler x86_64 assembly tail-calls conformance testing proof))
     (depends-on . (WSM-OS-CML-X86-FIXNUM-BRANCH-M5A))
     (origin . wsm-os)
     (description . "Preserve tail position as explicit admitted CML metadata and prove target-level stack safety before general closures. Implement exactly one first-order self-tail-call path whose x86 lowering restores/reuses the current frame and jumps rather than accumulating native calls. Differentially run the pinned 100,000-deep tail-recursion obligation through my-lisp, hosted generated x86 and QEMU; record bounded stack evidence. Non-tail calls, mutual recursion, closures and continuations remain separately unsupported unless explicitly added.")))

   ("WSM-OS-DEFINITION-CAPSULE-M5D" .
    ((priority . 7.8)
