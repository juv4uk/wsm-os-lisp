     (depends-on . (WSM-OS-DEFINITION-CAPSULE-M5D))
     (origin . wsm-os)
     (description . "Extend the opaque RuntimeContext with a versioned structured condition record while retaining the small noreturn wsm_fail(context, code) boot ABI. Record operation, offending values, definition/source identity and explicit restart-capability IDs; prove deterministic hosted/QEMU serialization for type and OOM failures. Do not claim resumable conditions, capture native continuations or implement arbitrary restart jumps in this task.")))

   ("WSM-OS-CONFORMANCE-LADDER-M5" .
    ((priority . 7.0)
     (capabilities . (my-lisp cml x86_64 assembly conformance testing proof))
     (depends-on . (WSM-OS-FIRST-QEMU-PARITY-M4 WSM-OS-CML-TAIL-CALL-PROOF-M5C))
