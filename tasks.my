; tasks.my — durable compiler-first implementation plan for wsm-os.
; `done . t` is added only after pushed implementation and evidence exist.

((kind . tasks-my)
 (tasks .
  (("WSM-OS-TARGET-ABI-M0" .
    ((priority . 10.0)
     (done . t)
     (capabilities . (architecture x86_64 assembly compiler contract proof))
     (depends-on . ())
     (origin . wsm-os)
     (description . "Define the machine-readable wsm-os x86_64 target ABI before any emitter uses numeric constants: little-endian 64-bit values; nil/true/fixnum/symbol/cons tags; ownership, alignment and heap pointer rules; System V AMD64 integer calling convention; versioned wsm_cons/wsm_car/wsm_cdr/wsm_eq/wsm_atom/wsm_fail imports; canonical result and structured failure records. Pin my-lisp/CML SHAs and the first (cons (quote A) (quote B)) oracle fixture. Add parser/validation tests for the contract. Do not import Rust Value/NanBox layout as authority.")
     (context . "completed 2026-08-29 by wsl-viveka-1 under direct owner assignment after swarm claim quorum was unavailable: fe168eb pushed. Dependency-free no_std wsm-os-target crate is the numeric source of truth; generated target-contract.wsm is byte-exact tested; 5/5 ABI tests, cargo check --lib, cargo fmt and my-lisp lint pass. CI added.")))

   ("WSM-OS-CML-X86-FREESTANDING-M1" .
    ((priority . 10.0)
     (done . t)
     (capabilities . (cml compiler rust x86_64 assembly lowering testing proof))
     (depends-on . (WSM-OS-TARGET-ABI-M0))
     (origin . wsm-os)
     (description . "Add the x86_64-freestanding GNU assembly backend to cml as a consumer of admitted shared Ir. Consume the wsm-os target contract, emit deterministic .s, and fail closed before partial output for unsupported nodes. First slice: the minimum Ir needed for the frozen cons/quoted-symbol fixture, then bounded Car/Cdr/Eq/Atom only with tests. Assemble the output and prove undefined symbols are restricted to the versioned wsm_* runtime ABI. No libc, OS, filesystem or silent C-backend fallback; do not claim full my-lisp 3.0.")
     (context . "completed 2026-08-29 by wsl-viveka-1 under direct owner assignment: CML commit 1f7142a pushed. Backend consumes pinned wsm-os-target fe168eb, preflights all IR before emission, supports literals/quote plus cons/car/cdr/eq/atom, and emits deterministic SysV AMD64 GNU assembly without libc or fallback. Real assembler/nm tests 5/5 pass, library tests 5/5 pass, GitHub Actions run 33244954299 SUCCESS.")))

   ("WSM-OS-HOST-RUNTIME-PARITY-M2" .
    ((priority . 9.0)
     (done . t)
     (capabilities . (rust x86_64 assembly runtime testing my-lisp proof))
     (depends-on . (WSM-OS-CML-X86-FREESTANDING-M1))
     (origin . wsm-os)
     (description . "Implement the shared freestanding wsm_* runtime core and a bounded hosted harness around the exact M1 object: tagged value encode/decode, interned fixture symbols, cons heap, deterministic bump allocation and structured OOM/type failure. Keep host startup/output outside the runtime core. Execute the frozen expression and require canonical result/error parity with pinned my-lisp. Hosted parity is not bare-metal evidence.")
     (context . "completed 2026-08-29 by Antigravity under direct owner assignment: 1750000 pushed.")))

   ("WSM-OS-BOOT-SUBSTRATE-DECISION-M3A" .
    ((priority . 8.0)
     (done . t)
     (capabilities . (research rust x86_64 uefi licensing architecture))
     (depends-on . (WSM-OS-TARGET-ABI-M0))
     (origin . wsm-os)
     (description . "Choose the smallest maintained x86_64 UEFI/QEMU boot substrate for the observed Gigabyte H170-Gaming 3 target and WSL/GitHub build environments. Verify exact license/NOTICE obligations, Rust target/tool requirements, deterministic serial test path and test-only QEMU exit. Compare candidates from primary docs; do not add a dependency until the decision is recorded and license-cleared.")))

   ("WSM-OS-BOOT-TOOLCHAIN-M3B" .
    ((priority . 8.0)
     (done . t)
     (capabilities . (guix rust qemu x86_64 build ci testing))
     (depends-on . (WSM-OS-BOOT-SUBSTRATE-DECISION-M3A))
     (origin . wsm-os)
     (description . "Provision the minimum reproducible toolchain selected by M3A: pinned Rust bare-metal target/components, QEMU and required linker/image tools through the repo manifest/CI. Prove clean tool discovery and a bounded no-op image build. Do not install broad toolchains or write physical devices.")))

   ("WSM-OS-SERIAL-BOOT-WITNESS-M3C" .
    ((priority . 9.0)
     (capabilities . (rust x86_64 uefi qemu serial testing ci proof))
     (depends-on . (WSM-OS-BOOT-TOOLCHAIN-M3B))
     (origin . wsm-os)
     (description . "Create the minimal freestanding boot image with entry point, panic path and serial writer. Under a bounded QEMU run emit exactly WSM-OS BOOT schema=1 arch=x86_64 status=ok and exit through the selected test mechanism. CI must distinguish success, panic and timeout. QEMU evidence only; no physical-disk or hardware write.")))

   ("WSM-OS-FIRST-QEMU-PARITY-M4" .
    ((priority . 10.0)
     (capabilities . (cml my-lisp x86_64 assembly rust qemu integration testing proof))
     (depends-on . (WSM-OS-HOST-RUNTIME-PARITY-M2 WSM-OS-SERIAL-BOOT-WITNESS-M3C))
